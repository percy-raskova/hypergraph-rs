        self, ebunch: Iterable[Any], weight: str = ..., **attr: Any
    ) -> None: ...
    def add_node(self, n: Hashable, **attr: Any) -> None: ...
    def add_nodes_from(self, nodes_for_adding: Iterable[Any], **attr: Any) -> None: ...
    def remove_node(self, n: Hashable, strong: bool = ..., remove_empty: bool = ...) -> None: ...
    def remove_edge(self, e: Hashable) -> None: ...
    def has_node(self, n: Hashable) -> bool: ...
    def has_edge(self, e: Hashable) -> bool: ...
    def memberships(self, n: Hashable) -> list[Hashable]: ...
    def members(self, e: Hashable) -> list[Hashable]: ...
    def degree(self, order: int | None = ...) -> dict[Hashable, int]: ...
    def render(self, strategy: str | None = ...) -> dict[str, Any]: ...

